{
  "name": "hytale",
  "display": "Hytale",
  "type": "none",
  "data": {
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IP",
      "desc": "What IP to bind the server to",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 5520,
      "display": "Port",
      "desc": "What port to bind the server to",
      "required": true,
      "userEdit": false
    },
    "ram": {
      "type": "integer",
      "value": 4,
      "display": "RAM (GB)",
      "desc": "How much memory in GB to allocate",
      "required": true,
      "userEdit": true
    },
    "javaversion": {
      "type": "string",
      "value": "25",
      "display": "Java Version",
      "desc": "Version of Java to use",
      "required": true,
      "userEdit": true
    },
    "jvmArgs": {
      "type": "string",
      "value": "-Xms1G",
      "display": "JVM Arguments",
      "desc": "Extra JVM arguments",
      "required": false,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "javadl",
      "version": "${javaversion}"
    },
    {
      "type": "download",
      "files": [
        "https://downloader.hytale.com/hytale-downloader.zip"
      ]
    },
    {
      "type": "extract",
      "file": "hytale-downloader.zip"
    },
    {
      "type": "command",
      "commands": [
        "chmod +x hytale-downloader-linux-amd64",
        "./hytale-downloader-linux-amd64 -skip-update-check -download-path game.zip"
      ]
    },
    {
      "type": "extract",
      "file": "game.zip"
    }
  ],
  "run": {
    "command": "java${javaversion} ${jvmArgs} -Xmx${ram}G -jar HytaleServer.jar --assets Assets.zip --disable-sentry --auth-mode authenticated --bind ${ip}:${port} --backup --backup-dir ../Backups --backup-frequency 30",
    "stop": "/stop",
    "workingDirectory": "Server",
    "pre": [],
    "post": []
  },
  "environment": {
    "type": "standard"
  },
  "supportedEnvironments": [
    {
      "type": "standard"
    },
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "eclipse-temurin:25",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "binaries": [
      "unzip"
    ],
    "os": "linux",
    "arch": "amd64"
  }
}
